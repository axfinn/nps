# syntax=docker/dockerfile:1
# 构建阶段使用 BUILDPLATFORM（即 CI 宿主机的原生架构，通常是 amd64）来编译，
# 再通过 GOOS/GOARCH 交叉编译到目标平台，从而彻底避免 QEMU 模拟编译（这是之前耗时 46~67 分钟的主因）。
FROM --platform=$BUILDPLATFORM golang:1.22 AS builder
ARG TARGETOS
ARG TARGETARCH
# 不要使用 GOPROXY=direct，否则会绕过 Go 模块代理、直接走 VCS（git）拉取，
# 在 CI 中既慢又容易超时/失败。这里用官方代理 + 国内镜像兜底 + direct 保底。
ARG GOPROXY=https://proxy.golang.org,https://goproxy.cn,direct
ENV GOPROXY=$GOPROXY
WORKDIR /go/src/ehang.io/nps
COPY . .

# 先单独下载依赖（便于 buildx 缓存分层，避免每次都重新拉模块）
RUN go mod download

# 构建 nps 服务端（交叉编译到目标平台，无需 QEMU 模拟）
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-w -s -extldflags -static" -o /out/nps ./cmd/nps/nps.go

# 构建常用的 npc 客户端（交叉编译，平台无关，一次即可）
RUN mkdir -p /tmp/downloads /tmp/web/static/download/client

# Linux 客户端
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags "-s -w -extldflags -static" -o /tmp/downloads/linux_amd64/npc ./cmd/npc/npc.go && \
    cp conf/npc.conf conf/multi_account.conf /tmp/downloads/linux_amd64/ && \
    tar -czvf /tmp/web/static/download/client/npc_linux_amd64.tar.gz -C /tmp/downloads/linux_amd64 .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags "-s -w -extldflags -static" -o /tmp/downloads/linux_arm64/npc ./cmd/npc/npc.go && \
    cp conf/npc.conf conf/multi_account.conf /tmp/downloads/linux_arm64/ && \
    tar -czvf /tmp/web/static/download/client/npc_linux_arm64.tar.gz -C /tmp/downloads/linux_arm64 .

# Windows 客户端
RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags "-s -w -extldflags -static" -o /tmp/downloads/windows_amd64/npc.exe ./cmd/npc/npc.go && \
    cp conf/npc.conf conf/multi_account.conf /tmp/downloads/windows_amd64/ && \
    tar -czvf /tmp/web/static/download/client/npc_windows_amd64.tar.gz -C /tmp/downloads/windows_amd64 .

# macOS 客户端
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -ldflags "-s -w -extldflags -static" -o /tmp/downloads/darwin_amd64/npc ./cmd/npc/npc.go && \
    cp conf/npc.conf conf/multi_account.conf /tmp/downloads/darwin_amd64/ && \
    tar -czvf /tmp/web/static/download/client/npc_darwin_amd64.tar.gz -C /tmp/downloads/darwin_amd64 .

RUN CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -ldflags "-s -w -extldflags -static" -o /tmp/downloads/darwin_arm64/npc ./cmd/npc/npc.go && \
    cp conf/npc.conf conf/multi_account.conf /tmp/downloads/darwin_arm64/ && \
    tar -czvf /tmp/web/static/download/client/npc_darwin_arm64.tar.gz -C /tmp/downloads/darwin_arm64 .

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /
COPY --from=builder /out/nps ./nps
COPY --from=builder /go/src/ehang.io/nps/web /web
COPY --from=builder /tmp/web/static/download/client /web/static/download/client
COPY --from=builder /go/src/ehang.io/nps/conf/nps.conf /conf/nps.conf
VOLUME /conf
EXPOSE 8024 8080 8443
ENTRYPOINT ["./nps"]
CMD ["-conf_path=/"]
